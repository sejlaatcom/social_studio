# ── Core ──
DATABASE_URL="postgresql://studio:studio@localhost:5432/social_studio?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
APP_URL="http://localhost:3000"            # public URL (used for OAuth redirect URIs)
ENCRYPTION_KEY=""                           # openssl rand -base64 32  (AES-256-GCM for tokens/API keys)
DEFAULT_PLAN="pro"                          # plan assigned to new organizations: free|basic|pro|business|enterprise

# ── Storage ── local disk or any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER="local"                      # local | s3
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                              # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
PUBLIC_MEDIA_BASE_URL=""                    # public https URL of this app, so Instagram/TikTok can fetch media (defaults to APP_URL)

# ── AI providers (optional here — can be set per workspace from Settings → AI) ──
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
STABILITY_API_KEY=""
ELEVENLABS_API_KEY=""
AI_ANTHROPIC_BASE_URL=""                    # optional gateway; default https://api.anthropic.com
AI_OPENAI_BASE_URL=""                       # optional gateway; default https://api.openai.com/v1

# ── Platform developer apps (optional here — can be set per workspace from Settings → Integrations) ──
GOOGLE_CLIENT_ID=""                         # Gmail + YouTube
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""                      # Meta app — Instagram API with Instagram Login
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_GRAPH_VERSION="v23.0"
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""                         # TikTok "Client key"
TIKTOK_CLIENT_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
